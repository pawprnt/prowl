{
  "name": "prowl-kali",
  "description": "Pre-configured Kali Linux image with prowl and security tools",
  "base_image": "kali-linux-2026.2-qemu-amd64.qcow2",
  "kali_version": "2026.2",
  "image_size": "40G",
  "ssh_port": 22,
  "default_user": "kali",
  "default_password": "kali",
  "qemu_command": "qemu-system-x86_64 -m 4096 -smp 2 -drive file=prowl-kali.qcow2,format=qcow2 -netdev user,id=net0,hostfwd=tcp::9222-:22 -device virtio-net-pci,netdev=net0 -enable-kvm",
  "ssh_command": "sshpass -p kali ssh -p 9222 kali@127.0.0.1",
  "manifests": {
    "tools": "tools.json",
    "go_tools": "go-tools.json",
    "system": "system.json"
  },
  "features": [
    "prowl",
    "nmap", "masscan", "unicornscan",
    "nuclei", "httpx", "subfinder", "katana", "naabu", "uncover",
    "ffuf", "gobuster", "wfuzz", "feroxbuster",
    "sqlmap", "nikto", "whatweb", "wpscan",
    "burpsuite", "zaproxy",
    "hydra", "john", "hashcat",
    "metasploit-framework",
    "responder", "impacket-scripts", "crackmapexec",
    "bloodhound",
    "binwalk", "radare2",
    "bettercap", "mitmproxy",
    "aircrack-ng", "kismet",
    "seclists", "wordlists"
  ],
  "size_estimate": "~15GB compressed to ~4GB"
}
